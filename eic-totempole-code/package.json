{
  "name": "eic-totempole-kiosk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Teksystem Budapest corporate lobby kiosk — Surface Hub 2S shell",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
